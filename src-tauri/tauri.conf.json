{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "影栈-本地视频播放器",
  "version": "1.0.0",
  "identifier": "app.local.videoplayer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "影栈-本地视频播放器",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/thumbs/**", "$APPDATA/remux/**"],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "targets": ["msi", "nsis", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Entertainment",
    "shortDescription": "轻量影栈-本地视频播放器",
    "longDescription": "本地视频扫描、分组、缩略图与播放工具，不联网、不上传。",
    "windows": {
      "wix": { "language": "zh-CN" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11",
      "signingIdentity": null,
      "providerShortName": null
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
