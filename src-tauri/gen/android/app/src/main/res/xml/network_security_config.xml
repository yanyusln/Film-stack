<?xml version="1.0" encoding="utf-8"?>
<!-- 只对本机回环放行明文：Android 媒体服务跑在 127.0.0.1（见 src/media_server.rs），
     release 构建 usesCleartextTraffic=false，不加这段视频就取不到数据。
     其余域名一律不允许明文，与 C3「不联网」一致——这里放行的是本机，不是外网。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
